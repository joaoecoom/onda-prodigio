{
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/comunidade/[[...slug]].js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/hub",
      "destination": "https://hub-dr-ecoom.vercel.app/",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "onda-prodigio.vercel.app"
        }
      ]
    },
    {
      "source": "/hub/:path*",
      "destination": "https://hub-dr-ecoom.vercel.app/:path*",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "onda-prodigio.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/tracking",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/ai-agent",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/recupera",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/impulsiona",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/integracoes",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/funil",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/checkout-builder",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/funnel/index.html",
      "has": [
        {
          "type": "host",
          "value": "onda-prodigio.vercel.app"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/funnel/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout9",
      "destination": "/checkout9/index.html"
    },
    {
      "source": "/checkout9-test",
      "destination": "/checkout9-test/index.html"
    },
    {
      "source": "/checkout19",
      "destination": "/checkout19/index.html"
    },
    {
      "source": "/vsl19",
      "destination": "/vsl19/index.html"
    },
    {
      "source": "/obgd/",
      "destination": "/obgd/index.html"
    },
    {
      "source": "/obgd",
      "destination": "/obgd/index.html"
    },
    {
      "source": "/obgd/upsell1",
      "destination": "/obgd/upsell1.html"
    },
    {
      "source": "/obgd/upsell2",
      "destination": "/obgd/upsell2.html"
    },
    {
      "source": "/obgd-test",
      "destination": "/obgd-test/index.html"
    },
    {
      "source": "/comunidade",
      "destination": "/comunidade/index.html"
    },
    {
      "source": "/comunidade/login",
      "destination": "/comunidade/login.html"
    },
    {
      "source": "/comunidade/hub-enter",
      "destination": "/comunidade/hub-enter.html"
    },
    {
      "source": "/comunidade/redefinir-password",
      "destination": "/comunidade/redefinir-password.html"
    },
    {
      "source": "/comunidade/produto",
      "destination": "/comunidade/produto.html"
    },
    {
      "source": "/comunidade/perfil",
      "destination": "/comunidade/perfil.html"
    },
    {
      "source": "/respostaquestionario",
      "destination": "/comunidade/respostaquestionario.html"
    },
    {
      "source": "/comprar/:productId",
      "destination": "/comprar/index.html"
    },
    {
      "source": "/metricas",
      "destination": "/metricas/index.html"
    },
    {
      "source": "/metricas/",
      "destination": "/metricas/index.html"
    },
    {
      "source": "/metricas/analise",
      "destination": "/metricas/analise.html"
    },
    {
      "source": "/adm",
      "destination": "/adm/index.html"
    },
    {
      "source": "/adm/",
      "destination": "/adm/index.html"
    },
    {
      "source": "/hub",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/:module",
      "destination": "/hub/index.html"
    },
    {
      "source": "/preview/:offer/:funnel/:page",
      "destination": "/api/sales-attribution?action=hub_page_preview&offer=:offer&funnel=:funnel&page=:page&preview=1"
    },
    {
      "source": "/p/:offer/:funnel/:page",
      "destination": "/api/sales-attribution?action=hub_page_preview&offer=:offer&funnel=:funnel&page=:page"
    },
    {
      "source": "/:funnel/:page",
      "destination": "/api/sales-attribution?action=hub_page_domain&funnel=:funnel&page=:page"
    },
    {
      "source": "/editor/:offer/:funnel/:page",
      "destination": "/hub/editor.html"
    },
    {
      "source": "/studio/:offer/:funnel/:page",
      "destination": "/hub/studio.html"
    }
  ],
  "headers": [
    {
      "source": "/metricas/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/metricas/"
        }
      ]
    },
    {
      "source": "/metricas/(index.html|analise.html|metricas.js|metricas.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/adm/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://hub-dr-ecoom.vercel.app"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
