{
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/comunidade/[[...slug]].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/tracking",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/recupera",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/impulsiona",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/integracoes",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/funil",
      "destination": "/hub/index.html",
      "has": [
        {
          "type": "host",
          "value": "hub.dr.ecoom.pt"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/checkout9",
      "destination": "/checkout9/index.html"
    },
    {
      "source": "/checkout9-test",
      "destination": "/checkout9-test/index.html"
    },
    {
      "source": "/checkout19",
      "destination": "/checkout19/index.html"
    },
    {
      "source": "/vsl19",
      "destination": "/vsl19/index.html"
    },
    {
      "source": "/obgd/",
      "destination": "/obgd/index.html"
    },
    {
      "source": "/obgd",
      "destination": "/obgd/index.html"
    },
    {
      "source": "/obgd/upsell1",
      "destination": "/obgd/upsell1.html"
    },
    {
      "source": "/obgd/upsell2",
      "destination": "/obgd/upsell2.html"
    },
    {
      "source": "/obgd-test",
      "destination": "/obgd-test/index.html"
    },
    {
      "source": "/comunidade",
      "destination": "/comunidade/index.html"
    },
    {
      "source": "/comunidade/login",
      "destination": "/comunidade/login.html"
    },
    {
      "source": "/comunidade/redefinir-password",
      "destination": "/comunidade/redefinir-password.html"
    },
    {
      "source": "/comunidade/produto",
      "destination": "/comunidade/produto.html"
    },
    {
      "source": "/comunidade/perfil",
      "destination": "/comunidade/perfil.html"
    },
    {
      "source": "/respostaquestionario",
      "destination": "/comunidade/respostaquestionario.html"
    },
    {
      "source": "/comprar/:productId",
      "destination": "/comprar/index.html"
    },
    {
      "source": "/metricas",
      "destination": "/metricas/index.html"
    },
    {
      "source": "/metricas/",
      "destination": "/metricas/index.html"
    },
    {
      "source": "/metricas/analise",
      "destination": "/metricas/analise.html"
    },
    {
      "source": "/adm",
      "destination": "/adm/index.html"
    },
    {
      "source": "/adm/",
      "destination": "/adm/index.html"
    },
    {
      "source": "/hub",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/:module",
      "destination": "/hub/index.html"
    }
  ],
  "headers": [
    {
      "source": "/metricas/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/metricas/"
        }
      ]
    },
    {
      "source": "/metricas/(index.html|analise.html|metricas.js|metricas.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
