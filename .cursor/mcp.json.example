        "mcp-remote",
        "https://mcp.stape.ai/mcp",
        "--header",
        "Authorization:COLOCA_AQUI_A_STAPE_API_KEY"
      ]
    },
    "gtm-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://gtm-mcp.stape.ai/mcp"
      ]
    }
  }
}
