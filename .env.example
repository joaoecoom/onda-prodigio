# WHATSAPP_MIN_DELAY_MS=5000
# WHATSAPP_MAX_DELAY_MS=45000
# Follow-up "ainda não entraste" — hora Portugal (Europe/Lisbon)
# NEVER_LOGGED_IN_CUTOFF_HOUR=15
# NEVER_LOGGED_IN_PEAK_AFTER_15H=15
# NEVER_LOGGED_IN_PEAK_BEFORE_15H=21
# NEVER_LOGGED_IN_MIN_HOURS=24

